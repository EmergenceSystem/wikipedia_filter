{application, wikipedia_filter, [
    {description, "em_filter agent for Wikipedia search"},
    {vsn, "0.2.0"},
    {registered, [wikipedia_filter_sup, wikipedia_filter_server]},
    {mod, {wikipedia_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        wikipedia_filter_sup,
        wikipedia_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/wikipedia_filter"}]}
]}.
